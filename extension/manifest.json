{
  "manifest_version": 3,
  "name": "Bookmark Page Extension",
  "version": "0.8.0",
  "description": "閲覧中のページをブックマークに追加します",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8788/*", "https://*.pages.dev/*"],
  "action": {
    "default_popup": "index.html"
  }
}
