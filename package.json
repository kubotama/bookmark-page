{
  "name": "bookmark-page",
  "type": "module",
  "private": true,
  "version": "0.4.2",
  "license": "MIT",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "wrangler pages dev ./dist",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "vite build",
    "build:extension": "tsc -p extension/tsconfig.json && vite build --config vite.config.extension.ts",
    "test:extension": "vitest run --config vite.config.extension.ts",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:format": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.17",
    "clsx": "^2.1.1",
    "hono": "4.12.26",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "uuidv7": "^1.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@hono/vite-build": "^1.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "chrome-types": "^0.1.429",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "happy-dom": "20.10.6",
    "jsdom": "29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "wrangler": "^4.4.0"
  }
}
